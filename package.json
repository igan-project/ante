{
  "name": "antejs",
  "version": "0.0.1",
  "description": "Ante is an immutable date / time / locale library alternative to Moment.js (or Day.js)",
  "keywords": [
    "ISO-8601",
    "antejs",
    "date",
    "dayjs",
    "immutable",
    "locale",
    "moment",
    "momentjs",
    "time"
  ],
  "license": "MIT",
  "author": "michaelhazan",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js",
      "require": "./dist/plugin/index.cjs"
    },
    "./extension": {
      "types": "./dist/extension/index.d.ts",
      "import": "./dist/extension/index.js",
      "require": "./dist/extension/index.cjs"
    },
    "./plugin/*": {
      "types": "./dist/plugin/*/index.d.ts",
      "import": "./dist/plugin/*/index.js",
      "require": "./dist/plugin/*/index.cjs"
    },
    "./extension/*": {
      "types": "./dist/extension/*/index.d.ts",
      "import": "./dist/extension/*/index.js",
      "require": "./dist/extension/*/index.cjs"
    },
    "./declarations/*": {
      "types": "./dist/declarations/*.d.ts"
    }
  },
  "scripts": {
    "size": "size-limit",
    "test": "vitest run",
    "test:bundle": "vitest run --project=bundle",
    "test:raw": "vitest run --project=\"!bundle\"",
    "test:watch": "vitest watch",
    "spell": "cspell .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typescript": "tsc",
    "build": "tsdown",
    "check": "turbo run test spell lint format:check typescript build"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@size-limit/preset-small-lib": "13.0.3",
    "@types/node": "25.9.5",
    "@vitest/coverage-v8": "4.1.11",
    "cspell": "10.1.0",
    "dayjs": "1.11.23",
    "knip": "6.32.2",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "pkg-pr-new": "0.0.88",
    "rollup-plugin-copy": "3.5.0",
    "size-limit": "13.0.3",
    "tsdown": "0.22.14",
    "turbo": "2.10.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "size-limit": [
    {
      "path": "./dist/index.js"
    },
    {
      "path": "./dist/index.cjs"
    }
  ],
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
