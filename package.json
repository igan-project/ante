{
  "name": "antejs",
  "version": "0.1.0-alpha.0",
  "description": "Ante is an immutable date / time / locale library alternative to Moment.js (or Day.js)",
  "keywords": [
    "ISO-8601",
    "antejs",
    "date",
    "day",
    "dayjs",
    "immutable",
    "locale",
    "moment",
    "momentjs",
    "time"
  ],
  "license": "MIT",
  "author": "michaelhazan",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.js"
      }
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js",
      "require": "./dist/plugin/index.js"
    },
    "./extension": {
      "types": "./dist/extension/index.d.ts",
      "import": "./dist/extension/index.js",
      "require": "./dist/extension/index.js"
    },
    "./plugin/*": {
      "types": "./dist/plugin/*/index.d.ts",
      "import": "./dist/plugin/*/index.js",
      "require": "./dist/plugin/*/index.js"
    },
    "./extension/*": {
      "types": "./dist/extension/*/index.d.ts",
      "import": "./dist/extension/*/index.js",
      "require": "./dist/extension/*/index.js"
    },
    "./declarations/*": {
      "types": "./dist/declarations/*.d.ts"
    }
  },
  "scripts": {
    "size": "size-limit",
    "test": "vitest run",
    "test:bundle": "vitest run --project=bundle",
    "test:raw": "vitest run --project=\"!bundle\"",
    "test:watch": "vitest watch",
    "spell": "cspell .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt . '.[!.]*'",
    "format:check": "oxfmt --check . '.[!.]*'",
    "typescript": "tsc",
    "build": "tsdown",
    "check": "turbo run test spell lint format:check typescript build"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@size-limit/preset-small-lib": "14.3.0",
    "@types/node": "26.6.11",
    "@vitest/coverage-v8": "5.1.2",
    "cspell": "10.5.2",
    "dayjs": "1.11.23",
    "knip": "6.48.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "pkg-pr-new": "0.0.94",
    "rollup-plugin-copy": "3.5.0",
    "size-limit": "14.3.0",
    "tsdown": "0.23.7",
    "turbo": "2.11.13",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  },
  "size-limit": [
    {
      "path": "./dist/index.js"
    }
  ],
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
