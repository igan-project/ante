{
  "name": "antejs",
  "version": "0.1.0-alpha.0",
  "description": "Ante is an immutable date / time / locale library alternative to Moment.js (or Day.js)",
  "keywords": [
    "ISO-8601",
    "antejs",
    "date",
    "day",
    "dayjs",
    "immutable",
    "locale",
    "moment",
    "momentjs",
    "time"
  ],
  "license": "MIT",
  "author": "michaelhazan",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.js"
      }
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js",
      "require": "./dist/plugin/index.js"
    },
    "./extension": {
      "types": "./dist/extension/index.d.ts",
      "import": "./dist/extension/index.js",
      "require": "./dist/extension/index.js"
    },
    "./plugin/*": {
      "types": "./dist/plugin/*/index.d.ts",
      "import": "./dist/plugin/*/index.js",
      "require": "./dist/plugin/*/index.js"
    },
    "./extension/*": {
      "types": "./dist/extension/*/index.d.ts",
      "import": "./dist/extension/*/index.js",
      "require": "./dist/extension/*/index.js"
    },
    "./declarations/*": {
      "types": "./dist/declarations/*.d.ts"
    }
  },
  "scripts": {
    "size": "size-limit",
    "test": "vitest run",
    "test:bundle": "vitest run --project=bundle",
    "test:raw": "vitest run --project=\"!bundle\"",
    "test:watch": "vitest watch",
    "spell": "cspell .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt . '.[!.]*'",
    "format:check": "oxfmt --check . '.[!.]*'",
    "typescript": "tsc",
    "build": "tsdown",
    "check": "turbo run test spell lint format:check typescript build"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@size-limit/preset-small-lib": "14.2.0",
    "@types/node": "25.9.9",
    "@vitest/coverage-v8": "5.0.5",
    "cspell": "10.4.0",
    "dayjs": "1.11.23",
    "knip": "6.41.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "pkg-pr-new": "0.0.91",
    "rollup-plugin-copy": "3.5.0",
    "size-limit": "14.2.0",
    "tsdown": "0.23.1",
    "turbo": "2.11.8",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "size-limit": [
    {
      "path": "./dist/index.js"
    }
  ],
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
